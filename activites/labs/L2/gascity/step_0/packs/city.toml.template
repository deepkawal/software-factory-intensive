# L2-step-0 factory city.toml.template.
#
# Expected gc doctor warnings (both tracked upstream):
#   ⚠ v2-default-rig-import-format  — workshop:#781
#   ⚠ v2-workspace-name             — workshop comment on gastownhall/gascity#600

[workspace]
name = "l2-step-0-factory"
provider = "claude"
default_rig_includes = ["./all"]

[session]
startup_timeout = "3m"

[daemon]
patrol_interval = "30s"
max_restarts = 5
restart_window = "1h"
shutdown_timeout = "5s"
