# W2-step-0 factory city.toml.template — checkpoint snapshot for W2 Part 1.
#
# default_rig_includes auto-stamps rig.Includes on `gc rig add <path>`.
# v1 shape preserved on schema=2 until upstream converges on the v2
# target shape (workshop:#781). Expected gc doctor warnings:
#   ⚠ v2-default-rig-import-format  — workshop:#781
#   ⚠ v2-workspace-name             — workshop comment on gastownhall/gascity#600

[workspace]
name = "w2-step-0-factory"
provider = "claude"
default_rig_includes = ["./all"]

[session]
startup_timeout = "3m"

[daemon]
patrol_interval = "30s"
max_restarts = 5
restart_window = "1h"
shutdown_timeout = "5s"
