[workspace]
name = "my-factory"
provider = "claude"

# Active lesson selection. gc imports this lesson pack into the rig named
# "rig" as the rig's "factory" pack. Point `source` at the lesson you are
# working (../packs/lessons/L2, L3, L4, C1) to switch the active lesson.
[[rigs]]
name = "rig"
[rigs.imports]
[rigs.imports.factory]
source = "../packs/lessons/L2"

[session]
startup_timeout = "3m"

[daemon]
formula_v2 = true
patrol_interval = "30s"
max_restarts = 5
restart_window = "1h"
shutdown_timeout = "5s"
