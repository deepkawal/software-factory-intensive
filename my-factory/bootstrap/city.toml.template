[workspace]
provider = "claude"

[providers.claude-fable]
base = "builtin:claude"
args_append = ["--model", "claude-fable-5-1"]
ready_delay_ms = 0

[providers.claude-opus]
base = "builtin:claude"
args_append = ["--model", "claude-opus-5"]
ready_delay_ms = 0

[providers.codex-sol]
base = "builtin:codex"
args_append = ["--model", "gpt-5.6-sol", "-c", "model_reasoning_effort=xhigh"]
ready_delay_ms = 0

[patches]

[[patches.agent]]
dir = ""
name = "ai_meal_planner/factory.architect"
provider = "codex-sol"
max_active_sessions = 4

[[patches.agent]]
dir = ""
name = "ai_meal_planner/factory.builder"
provider = "codex-sol"
idle_timeout = "20m"
max_active_sessions = 7

[[patches.agent]]
dir = ""
name = "ai_meal_planner/factory.designer"
provider = "claude"

[[patches.agent]]
dir = ""
name = "ai_meal_planner/factory.code-reviewer"
provider = "claude-opus"
max_active_sessions = 3

[[patches.agent]]
dir = ""
name = "ai_meal_planner/factory.architecture-reviewer"
provider = "claude-fable"
max_active_sessions = 4

[[patches.agent]]
dir = ""
name = "ai_meal_planner/factory.intake-pm"
max_active_sessions = 4

[[patches.agent]]
dir = ""
name = "ai_meal_planner/factory.planner"
max_active_sessions = 10

[[patches.agent]]
dir = ""
name = "ai_meal_planner/factory.product-reviewer"
max_active_sessions = 5

[[patches.agent]]
dir = ""
name = "ai_meal_planner/factory.validator"
provider = "claude"
max_active_sessions = 2

[session]
startup_timeout = "3m"

[daemon]
formula_v2 = true
patrol_interval = "30s"
max_restarts = 5
restart_window = "1h"
shutdown_timeout = "5s"
